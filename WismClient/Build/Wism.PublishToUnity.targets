<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <UnityPluginDir Condition="'$(UnityPluginDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\WismUnity\Assets\Plugins\WismClient\'))</UnityPluginDir>
    <CompanionPluginDir Condition="'$(CompanionPluginDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\WismCompanion\Assets\Plugins\WismShared\'))</CompanionPluginDir>
    <!-- The Unity companion only needs the shared contract DTOs and their core dependency. -->
    <PublishToCompanion Condition="'$(AssemblyName)' == 'Wism.Companion.Shared' or '$(AssemblyName)' == 'Wism.Client.Core'">true</PublishToCompanion>
  </PropertyGroup>

  <Target Name="CopyBinariesAndModsToUnity" AfterTargets="Build">
    <Message Text="Publishing $(AssemblyName) to Unity: $(UnityPluginDir)" Importance="high" />

    <ItemGroup>
      <UnityClientOutput Include="$(OutputPath)$(AssemblyName).dll" />
      <UnityClientOutput Include="$(OutputPath)$(AssemblyName).pdb" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    </ItemGroup>

    <Copy
      SourceFiles="@(UnityClientOutput)"
      DestinationFolder="$(UnityPluginDir)"
      SkipUnchangedFiles="true" />

    <!-- Also publish the shared contract assemblies into the standalone WismCompanion shell. -->
    <Message Text="Publishing $(AssemblyName) to WismCompanion: $(CompanionPluginDir)" Importance="high" Condition="'$(PublishToCompanion)' == 'true'" />
    <MakeDir Directories="$(CompanionPluginDir)" Condition="'$(PublishToCompanion)' == 'true'" />
    <Copy
      SourceFiles="@(UnityClientOutput)"
      DestinationFolder="$(CompanionPluginDir)"
      SkipUnchangedFiles="true"
      Condition="'$(PublishToCompanion)' == 'true'" />

    <ItemGroup>
      <UnityModFiles Include="$(OutputPath)mod\\**\\*" Condition="'$(IncludeModFiles)' == 'true'" />
    </ItemGroup>

    <Error Text="No mod files found to publish!" Condition="'$(IncludeModFiles)' == 'true' and '@(UnityModFiles)' == ''" />

    <Copy
      SourceFiles="@(UnityModFiles)"
      DestinationFiles="@(UnityModFiles->'$(UnityPluginDir)Mods\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'$(IncludeModFiles)' == 'true'" />
  </Target>

</Project>
